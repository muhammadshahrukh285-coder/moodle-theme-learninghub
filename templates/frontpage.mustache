{{#js}}
M.util.js_pending('theme_learninghub/navigation');

require(['theme_boost/loader'], function(Loader) {

    const links = document.querySelectorAll('.lh-nav-link');
    const sections = document.querySelectorAll(
        '#lh-services, #lh-work, #lh-about, #lh-contact'
    );

    function updateActiveNav() {
        let current = 'Home';

        sections.forEach(function(section) {
            const top = section.getBoundingClientRect().top;

            if (top <= 120) {
                current = section.id.replace('lh-', '');
            }
        });

        links.forEach(function(link) {
            link.classList.remove('active');

            const target = link.getAttribute('href');

            if (
                (current === 'services' &&
                    (target === '#lh-services')) ||
                (current === 'work' &&
                    target === '#lh-work') ||
                (current === 'about' &&
                    target === '#lh-about') ||
                (current === 'contact' &&
                    target === '#lh-contact') ||
                (current === 'Home' &&
                    target === '{{{ config.wwwroot }}}')
            ) {
                link.classList.add('active');
            }
        });
    }

    window.addEventListener('scroll', updateActiveNav, {
        passive: true
    });

    updateActiveNav();

    M.util.js_complete('theme_learninghub/navigation');

});
{{/js}}
